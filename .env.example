# ==========================================================
#  CRYPTO RADAR - Configuracion
#  Copia este archivo como .env y rellena los valores.
#  Ningun valor de aqui se sube a git (.env esta ignorado).
# ==========================================================

# ---------- Base de datos ----------
# Con docker compose no hace falta tocar nada: el host es "db".
DATABASE_URL=postgres://radar:radar_local_password@localhost:5432/radar
POSTGRES_PASSWORD=radar_local_password

# ==========================================================
#  CANALES DE AVISO
#  Configura AL MENOS UNO. Si configuras varios, el aviso se
#  envia por todos a la vez y basta con que uno funcione.
#  Comprueba que van con:  npm run test:alertas
# ==========================================================

# ---------- Opcion A: Telegram (GRATIS) ----------
# Necesita una cuenta de Telegram, que pide verificacion por telefono.
# 1. Abre Telegram y habla con @BotFather -> /newbot -> te da el token.
# 2. Habla con @userinfobot -> te dice tu "Id". Ese es el chat id.
# 3. IMPORTANTE: escribele /start a tu bot, si no no puede escribirte.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================================
#  ROBOT 2: RADAR DE TELEGRAM
#  Lee canales de Telegram en busca de tokens de los que se
#  habla, y el Robot 3 lo cruza con el analisis del Robot 1.
# ==========================================================

# Bot que lee los grupos donde se le anada. TIENE QUE SER OTRO
# BOT, no el de los avisos: si comparten token, Telegram entrega
# cada mensaje a uno solo y el otro deja de ver mensajes sin dar
# ningun error. Se crea igual, con @BotFather -> /newbot.
TELEGRAM_RADAR_TOKEN=

# Cuenta de usuario de Telegram: es la que busca canales nuevos y
# lee los publicos, que es lo que hace casi todo el trabajo.
# 1. Entra en https://my.telegram.org con el telefono de la cuenta.
# 2. "API development tools" -> crea una aplicacion -> copia
#    api_id y api_hash.
# 3. Con los dos puestos, ejecuta UNA vez:
#        node scripts/telegram-login.mjs
#    Pide el telefono y el codigo que llega a la app de Telegram, y
#    guarda TELEGRAM_SESSION aqui solo. No la copies a ningun sitio:
#    quien la tenga entra en la cuenta.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# TELEGRAM_SESSION=   (la escribe el script de arriba)

# Clave interna para que el Robot 2 pida analisis al Robot 1. Sin
# ella el Robot 2 encuentra tokens que nadie analiza y el Robot 3
# no tiene nada que cruzar. Cualquier texto largo y aleatorio:
#     openssl rand -hex 24
API_SHARED_SECRET=

# ---------- Opcion B: Discord (GRATIS, SIN TELEFONO) ----------
# Crear cuenta de Discord solo pide correo electronico.
# 1. Crea un servidor propio (boton "+" a la izquierda).
# 2. Ajustes del canal (rueda dentada) -> Integraciones -> Webhooks.
# 3. Nuevo webhook -> Copiar URL del webhook. Pegala aqui.
DISCORD_WEBHOOK_URL=

# ---------- Opcion C: Correo electronico ----------
# RECOMENDADO: Gmail con "contrasena de aplicacion". No hay revision de
# cuenta, no hace falta dominio propio y el limite (500 correos/dia) es
# 25 veces lo que necesita el sistema.
#
#   1. Crear (o usar) una cuenta de Gmail para el proyecto
#   2. Activar la verificacion en dos pasos en la cuenta de Google
#   3. Ir a https://myaccount.google.com/apppasswords
#   4. Crear una contrasena de aplicacion y pegarla en SMTP_PASS
#
# Alternativas sin dominio si Gmail no encaja: SMTP2GO o Mailjet.
# Nota: Brevo se probo y rechaza cuentas nuevas sin dominio propio.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=la-contrasena-de-aplicacion-de-16-letras
# Opcional. Dejalo vacio salvo que uses el puerto 465 (TLS directo): entonces "true".
SMTP_SECURE=
SMTP_FROM=tucuenta@gmail.com
# A que direccion quieres recibir las alertas.
ALERT_EMAIL_TO=

# ---------- Solana ----------
# Helius plan gratuito: https://dashboard.helius.dev  (crear cuenta -> API key)
# Si lo dejas vacio se usa el RPC publico de Solana (mas lento y con mas errores).
HELIUS_API_KEY=
SOLANA_RPC_URL=

# ---------- Base (EVM) ----------
# Alchemy plan gratuito: https://dashboard.alchemy.com -> App en "Base Mainnet"
# Si lo dejas vacio se usa https://mainnet.base.org (publico, limitado).
ALCHEMY_API_KEY=
BASE_RPC_URL=

# RPC aparte SOLO para eth_getLogs (reconstruccion de holders en Base).
# El plan gratuito de Alchemy limita eth_getLogs a 10 bloques por peticion, lo
# que hace inviable reconstruir la lista de holders. El RPC publico de Base
# admite rangos mucho mayores, asi que se usa ese para los logs.
# Si algun dia contratas Alchemy de pago, pon aqui la misma URL que BASE_RPC_URL.
BASE_LOGS_RPC_URL=https://mainnet.base.org

# Basescan (GRATIS, opcional pero recomendado): https://basescan.org/myapikey
# Se usa para saber quien creo el contrato y si esta verificado.
BASESCAN_API_KEY=

# ---------- Panel web ----------
# Contrasena de acceso al panel. Cambiala.
PANEL_PASSWORD=cambia-esta-clave
# Secreto para firmar la cookie de sesion. Cualquier texto largo y aleatorio.
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-de-32-caracteres-minimo
PORT=3000
HOST=0.0.0.0

# ---------- Comportamiento ----------
# development | production
NODE_ENV=production
LOG_LEVEL=info
# Pon en "true" para no enviar alertas de Telegram (util al probar).
ALERTS_MUTED=false
# Pon en "false" para arrancar solo el panel sin el motor de deteccion.
WORKER_ENABLED=true

# --- Segunda etapa del triaje (opcional) -----------------------------------
# Distingue una llamada de verdad de una promocion pagada bien escrita, que
# es lo unico que las reglas gratuitas no pueden hacer. Sin esto el sistema
# funciona igual que siempre: es una mejora, no un requisito.
#
# Ademas de clasificar, resume cada mensaje en espanol, dice su idioma y saca
# lo que afirma (liquidez bloqueada, sin permisos...) para que el Robot 3 lo
# compruebe contra la cadena.
#
# OJO CON LA CUOTA GRATUITA. Cada mensaje gasta unos 800 tokens. La capa
# gratuita de Groq da 200.000 tokens al dia para qwen/qwen3.8-27b, que son
# unos 250 mensajes. Por encima, los mensajes esperan al dia siguiente (se
# clasifican primero los que nombran un token). Para cubrir todo hace falta
# el plan de pago de Groq o un modelo con mas cuota.
#
#   gemini     Google. Capa gratuita. Es por donde yo empezaria.
#   openai     Groq, OpenRouter, Ollama o un modelo en el propio servidor.
#              Groq tambien tiene capa gratuita.
#   anthropic  API de Anthropic. De pago, pero la mejor calidad.
#
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_MODEL=
# Solo para 'openai', si no se usa Groq:
# LLM_BASE_URL=
