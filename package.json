{
  "name": "crypto-radar",
  "version": "1.0.0",
  "private": true,
  "description": "Radar de oportunidades tempranas en Solana y Base: deteccion, analisis de riesgo, scoring explicado, alertas de Telegram y panel web.",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/core/migrate.ts",
    "migrate:prod": "node dist/core/migrate.js",
    "worker": "tsx src/worker/index.ts",
    "web": "tsx src/web/server.ts",
    "selftest": "tsx src/selftest.ts",
    "test:alertas": "tsx src/testAlert.ts",
    "robot3:calibracion": "tsx scripts/robot3-calibracion.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/pruebas/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "croner": "^9.0.0",
    "fastify": "^5.2.1",
    "grammy": "^1.34.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "telegram": "^2.26.22",
    "viem": "^2.22.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
