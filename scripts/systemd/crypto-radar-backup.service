# /etc/systemd/system/crypto-radar-backup.service
# ---------------------------------------------------------------------------
# Copia de seguridad diaria de la base de datos.
#
# REEMPLAZA en Windows:
#   Tarea programada "CryptoRadar-Copia" (diaria, 03:30)
#     -> powershell -File Blockchain\scripts\copia-seguridad.ps1
#
# La tarea se quedo en la maquina Windows al migrar el 09/09. El ultimo
# volcado que hizo es radar-20260909-0330.dump; sin esta unidad no habria
# ninguno posterior.
#
# Lo lanza crypto-radar-backup.timer, no systemd directamente.
# ---------------------------------------------------------------------------

[Unit]
Description=Crypto Radar - copia de seguridad verificada de la base de datos
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=radar
Group=radar
WorkingDirectory=/opt/crypto-radar
ExecStart=/usr/bin/env bash /opt/crypto-radar/scripts/copia-seguridad.sh

# El volcado de 180 MB tarda; sin esto systemd lo mataria a medias y dejaria
# un fichero truncado, que es justo lo que la verificacion existe para evitar.
TimeoutStartSec=1800

StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto-radar-backup

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/crypto-radar /opt/crypto-radar/logs
